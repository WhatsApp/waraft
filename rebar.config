{minimum_otp_vsn, "28.0"}.

{erl_opts, [ debug_info
           , warnings_as_errors
           , warn_export_vars
           , warn_unused_import
           ]
}.

{profiles, [
    {test, [
        {deps, [
            {assert, {git, "https://github.com/WhatsApp/assert.git", {branch, "main"}}},
            {meck, "1.1.0"}
        ]}
    ]}
]}.

{dialyzer, [ {warnings, [unknown]}
           , {plt_apps, all_deps}
           ]}.

{xref_checks, [ undefined_function_calls
              , undefined_functions
              , locals_not_used
              , deprecated_function_calls
              , deprecated_functions
              ]}.
